# Copy this file to ".env" and fill in both values.
# Get them from your Ojin account: https://ojin.ai  (docs: https://docs.ojin.ai)

# Authenticates the request (Sign in -> API keys -> create one).
OJIN_API_KEY=

# The Face (avatar) model to drive (open a Face model and copy its config id).
OJIN_CONFIG_ID=

# Copy this file to ".env" and fill in the values.

# --- Ojin (the avatar / face) -------------------------------------------------
# Get these from your Ojin account: https://ojin.ai  (docs: https://docs.ojin.ai)

# Authenticates the request (Sign in -> API keys -> create one).
OJIN_API_KEY=

# The Face (avatar) model to drive (open a Face model and copy its config id).
OJIN_CONFIG_ID=

# --- The voice pipeline (LLM / TTS) -------------------------------------------
# NOTE: unlike example 03 there is NO speech-to-text — the AutonomousUserDriver
# synthesizes the user side — so no DEEPGRAM_API_KEY is needed.

# The LLM (Gemini). https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Text-to-speech (ElevenLabs). https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
